{
  "name": "rift-arpg",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.sim.json && tsc -p tsconfig.json",
    "test": "esbuild test/sim.test.ts --bundle --platform=node --outfile=dist/sim.test.js --log-level=warning && node dist/sim.test.js && esbuild test/ledger.test.ts --bundle --platform=node --outfile=dist/ledger.test.js --log-level=warning && node dist/ledger.test.js",
    "serve": "node scripts/build.mjs && npx --yes http-server dist -p 8080 -c-1",
    "build:live": "node scripts/build.mjs --live",
    "build:server": "esbuild src/server/server.ts --bundle --platform=node --format=esm --outfile=dist/server.mjs --external:ws --log-level=warning",
    "server": "npm run build:live && npm run build:server && node dist/server.mjs",
    "site": "node scripts/build.mjs && node scripts/site.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.24.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "ws": "^8.23.0"
  },
  "engines": {
    "node": ">=20"
  }
}
